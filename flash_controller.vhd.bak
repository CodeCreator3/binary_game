library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity flash_controller is
    port (
        clk          : in  std_logic;
        reset_n      : in  std_logic;
        start_save   : in  std_logic;
        start_load   : in  std_logic;
        data_in      : in  std_logic_vector(31 downto 0);
        data_out     : out std_logic_vector(31 downto 0);
        busy         : out std_logic
    );
end entity flash_controller;

architecture rtl of flash_controller is

    type state_t is (
        IDLE,
        ERASE_CMD,       -- Send sector erase command to CSR
        WAIT_ERASE_BUSY, -- Poll CSR status register until erase completes
        WRITE_WORD,      -- Assert write to data interface
        WAIT_WRITE,      -- Wait until waitrequest drops low
        READ_WORD,       -- Assert read to data interface
        WAIT_READ        -- Capture readdata when readdatavalid goes high
    );
    signal state : state_t := IDLE;

    -- UFM Avalon-MM registers
    signal csr_write       : std_logic := '0';
    signal csr_read        : std_logic := '0';
    signal csr_writedata   : std_logic_vector(31 downto 0) := (others => '0');
    signal csr_readdata    : std_logic_vector(31 downto 0);

    signal data_write      : std_logic := '0';
    signal data_read       : std_logic := '0';
    signal data_addr       : std_logic_vector(16 downto 0) := (others => '0');
    signal data_writedata  : std_logic_vector(31 downto 0) := (others => '0');
    signal data_readdata   : std_logic_vector(31 downto 0);
    signal waitrequest     : std_logic;
    signal readdatavalid   : std_logic;

begin

    busy <= '0' when state = IDLE else '1';

    process(clk, reset_n)
    begin
        if reset_n = '0' then
            state <= IDLE;
            csr_write  <= '0';
            csr_read   <= '0';
            data_write <= '0';
            data_read  <= '0';
        elsif rising_edge(clk) then
            case state is

                when IDLE =>
                    if start_save = '1' then
                        -- Sector Erase: CSR address 1 controls sector operations
                        csr_write       <= '1';
                        csr_writedata   <= x"00000001"; -- Bitmask/command for target sector
                        state           <= ERASE_CMD;
                    elsif start_load = '1' then
                        data_read       <= '1';
                        data_addr       <= (others => '0'); -- Target UFM offset
                        state           <= READ_WORD;
                    end if;

                when ERASE_CMD =>
                    csr_write <= '0';
                    csr_read  <= '1';
                    state     <= WAIT_ERASE_BUSY;

                when WAIT_ERASE_BUSY =>
                    -- Bit 0/1 of CSR register indicates write/erase busy status
                    if csr_readdata(1 downto 0) = "00" then
                        csr_read        <= '0';
                        -- Proceed to write data
                        data_write      <= '1';
                        data_addr       <= (others => '0');
                        data_writedata  <= data_in;
                        state           <= WRITE_WORD;
                    end if;

                when WRITE_WORD =>
                    -- Hold request until Avalon slave accepts it
                    if waitrequest = '0' then
                        data_write <= '0';
                        state      <= IDLE;
                    end if;

                when READ_WORD =>
                    if waitrequest = '0' then
                        data_read <= '0';
                        state     <= WAIT_READ;
                    end if;

                when WAIT_READ =>
                    if readdatavalid = '1' then
                        data_out <= data_readdata;
                        state    <= IDLE;
                    end if;

            end case;
        end if;
    end process;

    -- Instantiate the generated Altera On-Chip Flash IP
    u_flash : component altera_onchip_flash
        port map (
            clock                   => clk,
            reset_n                 => reset_n,
            avmm_data_addr          => data_addr,
            avmm_data_read          => data_read,
            avmm_data_write         => data_write,
            avmm_data_writedata     => data_writedata,
            avmm_data_readdata      => data_readdata,
            avmm_data_waitrequest   => waitrequest,
            avmm_data_readdatavalid => readdatavalid,
            avmm_csr_addr           => '0',
            avmm_csr_read           => csr_read,
            avmm_csr_write          => csr_write,
            avmm_csr_writedata      => csr_writedata,
            avmm_csr_readdata       => csr_readdata
        );

end architecture rtl;